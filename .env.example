# 115Transfer 环境变量配置示例
# 复制本文件为 .env 并修改为实际值

# 必填：登录密码（请修改为强密码）
APP_PASSWORD=change_me_to_strong_password

# 必填：Flask 会话密钥（32字节强随机值，可用 python -c "import secrets;print(secrets.token_hex(32))" 生成）
FLASK_SECRET_KEY=change_me_to_random_32_byte_hex

# 可选：敏感配置加密密钥（留空则回退到 FLASK_SECRET_KEY）
ENCRYPTION_KEY=

# 必填：CORS 白名单（逗号分隔，如 http://192.168.1.100:3698）
ALLOWED_ORIGINS=*

# 可选：企业微信代理写入令牌（保护 /wechat/proxy 接口）
WECHAT_PROXY_TOKEN=

# 可选：启用 HTTPS 时设为 true（会强制 Secure cookie）
HTTPS_ENABLED=false

# 可选：调试模式
FLASK_DEBUG=false

# 可选：时区
TZ=Asia/Shanghai
